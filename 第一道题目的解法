#include<stdio.h>
int main(void)
{
    int n,q;
    int a[100000000];
    int i,t;
    scanf("%d %d",&n,&q);
    int result=1;
    int cnt=1;
    a[0]=2;
    int b[1000000];
    for(i=3;i<=n;i++){
        result=1;
        for(t=2;t<i;t++){
            if(i%t==0){
                result=0;
                break;
            }
        }
        if(result){
            a[cnt]=i;
            cnt++;
        }
    }
    for(i=0;i<q;i++){
        scanf("%d",&b[i]);
    }
    for(i=0;i<q;i++){
        int f=b[i];
        f--;
        printf("%d\n",a[f]);
    }
    return 0;
    
}
